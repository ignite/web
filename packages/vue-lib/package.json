{
  "name": "@ignt/vue-library",
  "version": "1.0.4",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/vue-library.umd.cjs",
  "module": "./dist/vue-library.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=16.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "bignumber.js": "^9.3.0",
    "crypto-js": "^4.2.0",
    "gradient-avatar": "^1.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "exports": {
    ".": {
      "import": "./dist/vue-library.js",
      "require": "./dist/vue-library.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/style.css": "./dist/vue-library.css"
  },
  "peerDependencies": {
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.0.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.15.32",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.29.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "~10.2.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vue-tsc": "^2.2.10"
  }
}
